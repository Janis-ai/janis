# Janis env reference — everything the API reads, grouped by feature.
# "required" = the feature is dead without it; unset vars mean that feature
# is off, not broken, unless noted. Copy to apps/api/.env for dev.

# ── Core ──────────────────────────────────────────────────────────────
PORT=8787
# Postgres connection string. If unset, the API uses embedded PGlite at
# PGLITE_DIR. Required for production + multi-instance.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/janis
# Postgres pool size PER INSTANCE (postgres-js max). Default 8 — with
# --max-instances 3 that's ≤24 conns; size it against your Neon plan's
# max_connections (or the pooler's), plus headroom for migrations + Neon ops.
# DB_POOL_MAX=8
# Skip running migrations at boot. deploy-gcp.sh runs `npm run db:migrate`
# as a pre-deploy step and sets this — schema is current before instances
# boot, so boot-time migrate only races the startup probe (prod flake class).
# Keep unset for local dev; set for any env where migrations run out-of-band.
# SKIP_DB_MIGRATE=1
# PGlite data dir — set outside iCloud/Dropbox-synced folders (live DB + file
# sync = corruption). One tsx watch per dir at a time.
# PGLITE_DIR=~/.janis/pglite
SESSION_SECRET=change-me-to-a-long-random-string
# AES-256-GCM key for agent secrets (tool-call credentials) — 32 bytes hex or
# base64. Defaults to a key derived from SESSION_SECRET; set this in prod —
# secrets encrypted under a derived key break if SESSION_SECRET rotates.
# JANIS_SECRETS_KEY=
# Public origins — CORS + webhook docs + email/Slack links back to the console.
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787
# NODE_ENV=production disables password login unless ALLOW_PASSWORD_LOGIN=1.
# Password auth stays on in dev for the seed admin + tests.
# ALLOW_PASSWORD_LOGIN=
# Plan assigned to new workspaces (key into PLANS: free/starter/pro/scale).
# DEFAULT_PLAN=free

# ── Notifications ─────────────────────────────────────────────────────
# Web push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@janis.ai

# Transactional email alerts via Resend (https://resend.com) — alerts are
# email-disabled until RESEND_API_KEY is set; JANIS_EMAIL_FROM must use a
# domain verified in your Resend account.
RESEND_API_KEY=
JANIS_EMAIL_FROM=Janis <alerts@janis.ai>

# ── Email channel ─────────────────────────────────────────────────────
# Inbound mail becomes conversations, replies send via Resend.
# EMAIL_INBOUND_DOMAIN: the domain channel addresses are minted under
# (ch_xxxx@domain) — its MX records must point at your inbound provider
# (Resend → Receiving).
EMAIL_INBOUND_DOMAIN=inbound.janis.ai
# Resend webhooks — create two in the Resend dashboard, each shows its
# signing secret once:
#   /channels/email/inbound ← email.received        → RESEND_INBOUND_SECRET
#   /channels/email/events  ← bounced/complained/failed → RESEND_EVENTS_SECRET
# (events falls back to the inbound secret when unset).
RESEND_INBOUND_SECRET=
RESEND_EVENTS_SECRET=

# ── Slack (alerts + takeover + Sign in with Slack) ────────────────────
# One Slack app powers all three. Add redirect {API_ORIGIN}/auth/slack/callback
# + openid/profile/email scopes. SLACK_SIGNING_SECRET_ALT accepts a second
# secret during key rotation.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# SLACK_SIGNING_SECRET_ALT=
# SLACK_REDIRECT_URI=   # override; defaults to {API_ORIGIN}/auth/slack/callback

# ── Google (sign-in + Gmail channel) ──────────────────────────────────
# Redirect URI: {API_ORIGIN}/auth/google/callback. The same OAuth client
# powers the Gmail channel — also register {API_ORIGIN}/gmail/callback
# (or override with GMAIL_REDIRECT_URI). gmail.readonly + gmail.send are
# restricted scopes: unverified apps cap at 100 test users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
GMAIL_REDIRECT_URI=
# Gmail push (near-real-time inbound): Pub/Sub topic the watch() targets +
# shared token on the push URL. Falls back to 60s polling when unset.
# GMAIL_PUBSUB_TOPIC=projects/<proj>/topics/gmail-push
# GMAIL_PUSH_TOKEN=

# ── Outlook / Office 365 channel ──────────────────────────────────────
# Azure app registration (Microsoft Graph). MS_TENANT 'common' = multi-tenant.
# MS_PUSH_TOKEN is a shared secret on the push webhook URL.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT=common
# MS_REDIRECT_URI=   # defaults to {API_ORIGIN}/outlook/callback
# MS_PUSH_TOKEN=

# ── Meta channels (Messenger / Instagram / WhatsApp) ──────────────────
# OAuth connect flow redirect: {API_ORIGIN}/api/meta/callback
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ── LLM ───────────────────────────────────────────────────────────────
# Janis-side suggestion fallback + hosted-agent default (OpenAI-compatible).
JANIS_LLM_API_KEY=
JANIS_LLM_BASE_URL=https://api.openai.com/v1
JANIS_LLM_MODEL=gpt-4o-mini
# Second model tried when the primary keeps failing (429/5xx/timeouts).
# JANIS_LLM_FALLBACK_MODEL=
# Janis-metered provider accounts — the hosted model picker offers every
# catalog model whose vendor has a key. Optional <VENDOR>_LLM_BASE_URL
# overrides the vendor default. OPENROUTER_LLM_API_KEY serves all vendors
# via vendor/id routing. JANIS_LLM_PROVIDERS JSON is an alternative to
# per-vendor vars: {"anthropic":{"api_key":"…","base_url":"…"}}
OPENAI_LLM_API_KEY=
ANTHROPIC_LLM_API_KEY=
GOOGLE_LLM_API_KEY=
# XAI_LLM_API_KEY= DEEPSEEK_LLM_API_KEY= MOONSHOT_LLM_API_KEY= ZAI_LLM_API_KEY=
# NVIDIA_LLM_API_KEY= MISTRAL_LLM_API_KEY= OPENROUTER_LLM_API_KEY=
# Org-scoped Anthropic keys: workspace UUID from console.anthropic.com →
# Settings → Workspaces.
# ANTHROPIC_LLM_WORKSPACE=
# Custom rate card: {"gpt-4o-mini":{"input":0.15,"output":0.6}} ($/1M tok).
# Unset = built-in price table.
# LLM_PRICES=
# Rolling-24h LLM spend circuit breaker per workspace (micro-USD; default
# $25 = 25000000; 0 disables). Over cap → agents pause + escalate.
# LLM_DAILY_CAP_MICROS=25000000
# Agent web_search builtin tool (Brave/Tavily-style key). Unset = tool off.
# JANIS_SEARCH_API_KEY=

# ── Billing (Stripe) ──────────────────────────────────────────────────
# sk_live_/sk_test_ + whsec for /billing/stripe-webhook.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Recurring plan prices (per plan, optional _YEARLY variants for annual):
# STRIPE_PRICE_STARTER= / STRIPE_PRICE_PRO= / STRIPE_PRICE_SCALE=
# STRIPE_PRICE_STARTER_YEARLY= … (create yearly Prices in Stripe first)
# Metered prices (usage billing): per-plan message overage + LLM + voice.
# STRIPE_METER_PRICE_STARTER= / PRO= / SCALE= / LLM= / VOICE=
# TRIAL_DAYS=   # checkout trial_period_days; workspaces.trialed_at enforces once
# Markup on metered usage (LLM tokens + voice minutes): billed = cost × (1+x).
# BILLING_MARGIN=0.2

# ── Hosted voice / SMS (Twilio) ───────────────────────────────────────
# Master Twilio account that provisions per-channel subaccounts + numbers.
# Empty = BYO-creds voice/SMS only (customers paste their own Twilio creds).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Country code hosted numbers are purchased in.
# TWILIO_VOICE_COUNTRY=US
# Abuse caps: live hosted numbers per workspace (default 3) and provisioning
# attempts per workspace per day (default 10).
# VOICE_HOSTED_MAX=3
# VOICE_PROVISION_DAILY=10
# Janis's cost per hosted voice minute in micro-USD (Twilio inbound ≈
# $0.014/min = 14000) — billed to the customer at cost × (1+BILLING_MARGIN).
# VOICE_COST_MICROS_PER_MIN=14000

# ── Webchat abuse caps ────────────────────────────────────────────────
# Postgres-backed, holds across instances. Per channel token per hour:
# CHAT_TOKEN_HOURLY_MAX=600         # messages (default 600)
# CHAT_TOKEN_UPLOAD_HOURLY_MAX=60   # file uploads (default 60)

# ── WorkOS (enterprise SSO + SCIM) ────────────────────────────────────
# AuthKit SSO + Directory Sync. Redirect: {API_ORIGIN}/auth/sso/callback.
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# WORKOS_REDIRECT_URI=
# WORKOS_DIRECTORY_WEBHOOK_SECRET=   # verifies /workos/directory-events

# ── Janis-internal ────────────────────────────────────────────────────
# Webchat channel id for the "Ask Janis" console concierge rail. Empty hides
# the rail. JANIS_OPERATOR_WORKSPACE_ID gates the account_status builtin so
# only our concierge can look up a signed-in user's plan.
# JANIS_SUPPORT_CHANNEL_ID=
# JANIS_OPERATOR_WORKSPACE_ID=
# GA4 measurement id (G-…) — when set, the served SPA gets the gtag snippet
# (landing events + funnel events from the console). Unset = no analytics.
# GA_MEASUREMENT_ID=

# ── Demo seed account (first boot) ────────────────────────────────────
SEED_ADMIN_EMAIL=admin@janis.local
SEED_ADMIN_PASSWORD=janis-admin

# ── Legacy (migrated-platform support — only set if migrating old bots) ──
# WORDHOP_API_URL=            # legacy Wordhop API relay
# JANIS_SOCKET_SERVER_URL=    # Heroku socket relay for legacy bots
# JANIS_RELAY_SECRET=         # shared secret for the relay
# LEGACY_SLACK_INTERACTIONS_URL=
# META_LEGACY_WEBHOOK_URL=
