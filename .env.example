# API
PORT=8787
# Postgres connection string. If unset, the API uses embedded PGlite at ./.pglite
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/janis
SESSION_SECRET=change-me-to-a-long-random-string
# Public origin of the web app (for CORS + webhook docs)
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787

# Web push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@janis.ai

# Optional Slack integration (same app powers Sign in with Slack —
# add redirect {API_ORIGIN}/auth/slack/callback + openid/profile/email scopes)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Optional Google sign-in (redirect URI: {API_ORIGIN}/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hosted Meta channels (Messenger / Instagram / WhatsApp)
# OAuth connect flow redirect: {API_ORIGIN}/api/meta/callback
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Janis-side suggestion fallback (OpenAI-compatible)
JANIS_LLM_API_KEY=
JANIS_LLM_BASE_URL=https://api.openai.com/v1
JANIS_LLM_MODEL=gpt-4o-mini

# Demo seed account (first boot)
SEED_ADMIN_EMAIL=admin@janis.local
SEED_ADMIN_PASSWORD=janis-admin
