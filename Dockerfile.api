FROM node:22-alpine AS build
# playwright's postinstall would otherwise download ~400MB of browsers into
# every build (and ship them in the runtime image) — the UI smoke harness
# runs locally, never in this container.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY packages/sdk/package.json packages/sdk/
COPY packages/agent-template/package.json packages/agent-template/
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build -w packages/shared && npm run build -w packages/sdk \
    && (npm run build -w apps/api & npm run build -w apps/web; wait)
# Ship only production deps — dev deps (vite, drizzle-kit, playwright…)
# were needed to compile dist/ but nothing in dist/ imports them.
RUN npm prune --omit=dev

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 8787
CMD ["node", "apps/api/dist/index.js"]
