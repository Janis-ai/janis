{
  "name": "@janis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio --config drizzle.studio.config.ts",
    "seed": "tsx src/seed.ts",
    "demo-agent": "tsx scripts/demo-agent.ts",
    "import-legacy": "tsx scripts/import-legacy.ts",
    "set-plan": "tsx scripts/set-plan.ts",
    "slack-manifest-sync": "tsx scripts/slack-manifest-sync.ts",
    "migrate-slack-teams": "tsx scripts/migrate-slack-teams.ts",
    "migrate-to-pg": "tsx scripts/migrate-to-pg.ts",
    "sync-from-prod": "tsx scripts/sync-from-prod.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.4.3",
    "@janis/shared": "0.1.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.11",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.5",
    "stripe": "^22.6.2",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.2"
  }
}
