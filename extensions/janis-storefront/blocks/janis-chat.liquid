{% comment %}
  Janis storefront chat — an app embed the merchant toggles under
  Theme Settings → App embeds. It pulls a shop-scoped loader from
  app.janis.ai which resolves shop → bound agent → Bubble channel and
  injects widget.js (a no-op until the shop is linked to an agent).
  The block handle is `janis-chat` — referenced by the activation deep
  link the embedded app renders (`activateAppId=<api_key>/janis-chat`).

  Settings here are OPTIONAL theme-level overrides — blank/unset fields
  fall back to the channel's Bubble config in the Janis console, so the
  embed stays zero-config for merchants who never open them.
{% endcomment %}
<script src="https://app.janis.ai/api/shopify/storefront.js?s={{ shop.permanent_domain }}&accent={{ block.settings.accent_color | url_encode }}&position={{ block.settings.position | url_encode }}&logo={{ block.settings.logo_image | image_url: width: 256 | url_encode }}&launcher={% if block.settings.launcher_icon == 'custom' and block.settings.launcher_image %}{{ block.settings.launcher_image | image_url: width: 256 | url_encode }}{% else %}{{ block.settings.launcher_icon | url_encode }}{% endif %}&teaser={{ block.settings.teaser_text | url_encode }}&greeting={{ block.settings.greeting | url_encode }}&qrs={{ block.settings.quick_replies | url_encode }}{% if customer %}&cid={{ customer.id | url_encode }}&cemail={{ customer.email | url_encode }}&cname={{ customer.name | url_encode }}{% endif %}" async></script>
{% schema %}
{
  "name": "Janis chat",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Bubble + header color. Blank uses your Janis channel setting (default purple #5b21b6)."
    },
    {
      "type": "select",
      "id": "position",
      "label": "Bubble position",
      "default": "",
      "options": [
        { "value": "", "label": "Channel default" },
        { "value": "right", "label": "Bottom right" },
        { "value": "left", "label": "Bottom left" }
      ]
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Chat window logo",
      "info": "Shown in the header of the open chat window. Blank uses your Janis channel setting."
    },
    {
      "type": "select",
      "id": "launcher_icon",
      "label": "Launcher icon",
      "default": "",
      "info": "The circular button shoppers tap to open chat. The chat icon is the most recognizable; a mascot or logo image works too.",
      "options": [
        { "value": "", "label": "Channel default" },
        { "value": "glyph", "label": "Chat icon" },
        { "value": "logo", "label": "Header logo" },
        { "value": "custom", "label": "Custom image" }
      ]
    },
    {
      "type": "image_picker",
      "id": "launcher_image",
      "label": "Custom launcher image",
      "info": "Used when Launcher icon is \"Custom image\". Square works best — it's cropped into a circle."
    },
    {
      "type": "header",
      "content": "Messaging"
    },
    {
      "type": "text",
      "id": "teaser_text",
      "label": "Teaser text",
      "info": "The little prompt beside the closed bubble. Blank uses your Janis channel setting.",
      "placeholder": "Questions? Chat with us."
    },
    {
      "type": "text",
      "id": "greeting",
      "label": "Greeting",
      "info": "First message when a shopper opens the chat. Blank uses your Janis channel setting.",
      "placeholder": "Hi! How can I help?"
    },
    {
      "type": "text",
      "id": "quick_replies",
      "label": "Quick replies",
      "info": "Comma-separated starter chips shown when the chat opens. Blank uses your Janis channel setting.",
      "placeholder": "Track my order, Returns, Talk to a human"
    }
  ]
}
{% endschema %}
