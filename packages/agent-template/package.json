{
  "name": "@janis/agent-template",
  "version": "0.1.0",
  "description": "Janis-ready LLM agent — boots from Janis config, honors takeover, serves hosted channels",
  "license": "MIT",
  "type": "module",
  "bin": { "janis-agent": "./dist/index.js" },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@janis/sdk": "^0.1.0",
    "@janis/shared": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
