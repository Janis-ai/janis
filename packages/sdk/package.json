{
  "name": "@janis/sdk",
  "version": "0.1.0",
  "description": "Janis client for AI agents — report conversations, request human takeover, receive human messages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "import": "./dist/webhook.js"
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@janis/shared": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
